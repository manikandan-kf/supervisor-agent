# Copy to .env and fill in. .env is gitignored and must never be committed.
#
# Scope: this file configures the **operator scripts** in scripts/ when you run
# them from a workstation. The deployed endpoint does not read it — its
# environment is set by the deploy job from databricks.yml variables (see
# deploy/log_and_deploy.py). Anything you change here affects your local runs
# only; to change the endpoint, change the bundle variable and redeploy.
#
# Every variable below is optional unless marked REQUIRED. Defaults live in
# src/supervisor/settings.py and are safe for development.

# ── Databricks workspace ─────────────────────────────────────────────────────
# REQUIRED for the scripts that call the workspace.
#
# Two ways to authenticate, and only one is needed:
#   1. A CLI profile — run `databricks auth login --host <workspace-url>` and
#      set DATABRICKS_CONFIG_PROFILE in your shell. Leave the two values below
#      empty. This is the simplest option for an individual operator.
#   2. A service principal (OAuth M2M) — set all three below. Use this for
#      unattended runs and for any caller that invokes the serving endpoint.
#
# Leave CLIENT_ID/CLIENT_SECRET **empty** rather than stale: an empty pair falls
# back to profile authentication, while a dead pair fails with a confusing 401.
DATABRICKS_HOST=
DATABRICKS_CLIENT_ID=
DATABRICKS_CLIENT_SECRET=

# ── Durable state (Lakebase Postgres) ────────────────────────────────────────
# Backs conversation checkpoints, long-term memory, the governed configuration
# table, the review queue and the audit sink. Set ONE of these.
#
# Provisioned-generation instance:
LAKEBASE_INSTANCE=supervisor-memory
# Newer Autoscaling-generation instances use a project/branch pair instead:
# LAKEBASE_AUTOSCALING_ENDPOINT=
# LAKEBASE_PROJECT=
# LAKEBASE_BRANCH=
# Or any reachable Postgres, for local work:
# SUPERVISOR_PG_DSN=postgresql://user:password@localhost:5432/supervisor
#
# With none of these set the supervisor falls back to in-memory state: history
# is lost on restart and the decision trail is not queryable. Acceptable for a
# local smoke test, never for a deployed environment — a deployed one refuses to
# boot rather than degrade (see ENVIRONMENT below).

# The Postgres schema holding this environment's durable state — checkpoints,
# long-term memory, the governed configuration table, the review queue and the
# audit trail. One Lakebase instance serves every environment; the schema is
# what keeps them apart.
#
# DERIVED from ENVIRONMENT (below): supervisor_dev, supervisor_prod, … Leave it
# commented out unless you need a shape the convention does not cover:
#
#   LAKEBASE_SCHEMA=public               the single-schema shape, for a
#                                        deployment made before environments
#                                        were separated
#   LAKEBASE_SCHEMA=supervisor_scratch   a second isolated copy of one environment
#
# The schema must already exist before anything writes to it:
#
#   python scripts/provision_lakebase.py --instance supervisor-memory \
#       --skip-instance --pg-schema supervisor_dev --grant-identity <endpoint-sp>
#
# A search_path naming a schema that does not exist is not an error in
# Postgres — an unqualified CREATE TABLE falls through to `public` — so a typo
# here does not fail, it silently pools the environments.
# LAKEBASE_SCHEMA=

# ── Session notes (short-term memory) ────────────────────────────────────────
# "…, keep this in mind for later" is acknowledged and held for the rest of the
# conversation instead of being dispatched as work. Notes are checkpointed with
# the thread, so they die with the session and are NEVER written to long-term
# memory — that store takes validated identifiers, not sentences.
#
# A note reaches the worker and no governance model, so it can shape a draft and
# cannot change a decision. See src/supervisor/session_notes.py.
#
# SESSION_NOTES_MAX=0 turns the feature off: such a turn is then routed and
# dispatched exactly as it was before.
SESSION_NOTES_MAX=20
SESSION_NOTE_MAX_CHARS=500

# ── Governance model ─────────────────────────────────────────────────────────
# The serving endpoint used for guardrail verdicts and context resolution. Must
# exist in the workspace and be on the approved model list.
ROUTING_LLM_ENDPOINT=databricks-claude-sonnet-4-5

# Which agent owns a request when the caller can reach several. The screen asks
# each permitted agent in turn and stops early only when a verdict clears
# ROUTING_DECISIVE_CONFIDENCE; below that the rest are asked and the strongest
# claim wins, so ownership is a comparison rather than an ordering. Within
# ROUTING_CONTESTED_MARGIN of each other the user is asked which deliverable
# they meant instead of the supervisor picking.
#
# Both are read by the deployed endpoint from its own environment, not from
# this file — they are here because raising the first is the one guardrail knob
# an operator may reasonably want to tune, and lowering it to the acting
# threshold restores first-past-the-post routing.
# ROUTING_DECISIVE_CONFIDENCE=0.9
# ROUTING_CONTESTED_MARGIN=0.15

# ── Unity Catalog ────────────────────────────────────────────────────────────
# Where the prompts, the registered model and the governed configuration live.
# One schema per deployed environment, named after the bundle target.
#
# DERIVED from ENVIRONMENT (below). Uncomment only to override:
#   PROMPT_ALIAS           to read a version promoted under another alias, e.g.
#                          a release candidate pinned by register_prompts.py
#   PROMPT_CATALOG_SCHEMA  to read prompts from another environment's schema
#   SUPERVISOR_CATALOG     to move the whole project to another UC catalog
# PROMPT_CATALOG_SCHEMA=
# PROMPT_ALIAS=
# SUPERVISOR_CATALOG=workspace

# ── Which environment this process is — THE one knob ─────────────────────────
# Changing this one value moves every per-environment name together, so they
# cannot disagree:
#
#   prompt alias            @dev / @prod
#   Unity Catalog schema    workspace.supervisor_dev / _prod   (prompts, model)
#   Lakebase schema         supervisor_dev / supervisor_prod   (state, audit)
#
# It also decides a second, separate thing:
#
#   what may degrade   `local` is the ONLY value that lets a control weaken —
#                      in-memory conversation state when no store is reachable,
#                      a warning instead of a refusal on a disabled setting
#
# Two rules, one input. `local` reads **dev's** resources while keeping the
# workstation's licence to degrade, which is why this file says `local`: it
# configures a workstation. The deployed environments are `dev` and `prod`, both
# on Databricks, both held to the full contract; databricks.yml stamps their
# value onto the endpoint. A third environment needs no code change — add the
# target to databricks.yml and every name follows.
#
# Overriding the names above is how you point a workstation at prod's data, and
# it is deliberately more than a one-word edit.
ENVIRONMENT=local

# ── Entitlement signing (optional, off by default) ───────────────────────────
# When set, the supervisor requires an HMAC over the caller's entitlements and
# refuses unsigned ones. Set the SAME value on the front door and the endpoint,
# via Databricks secrets — never commit a real value. Leave empty to keep the
# endpoint ACL as the trust boundary.
SUPERVISOR_TRUST_SECRET=
