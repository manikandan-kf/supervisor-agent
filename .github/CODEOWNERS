# Review is required on every path here — set branch protection on `main` to
# "require a pull request with at least one approving review" for this file to
# have any effect.
#
# Replace the placeholders with the client's own team handles before the first
# push; an unresolvable owner silently reviews nothing.

# Everything, by default.
*                               @<org>/<platform-team>

# The governance surface. A change to any of these changes what every agent on
# the platform is allowed to do, or what it can be shown to have done, so it
# deserves a named reviewer rather than the default one.
/libs/agent_governance/             @<org>/<security-team>
/src/supervisor/guardrail_engine.py @<org>/<security-team>
/src/supervisor/nodes/rbac_gate.py  @<org>/<security-team>
/src/supervisor/nodes/guardrails.py @<org>/<security-team>
/src/supervisor/config.py           @<org>/<security-team>
/src/supervisor/config/             @<org>/<security-team>
/SECURITY.md                        @<org>/<security-team>

# The deployment path.
/databricks.yml                     @<org>/<platform-team>
/resources/                         @<org>/<platform-team>
/deploy/                            @<org>/<platform-team>
/.github/workflows/                 @<org>/<platform-team>
